 namespace gufo::models::deepseek_v41_flash {
 
+/// The temperature while `sampler`'s next selection is plain softmax sampling
+/// over the whole vocabulary: what SamplerState::Sample draws through its
+/// unfiltered linear distribution, with no filter, penalty, grammar, forced
+/// or deferred token. Otherwise 0; such draws stay on the host.
+inline float DeviceSamplingTemperature(const sampling::SamplerState& sampler) {
+  const auto& config = sampler.config();
+  const bool plain =
+      config.temperature > 0.F && config.top_k == 0 && config.top_p == 1.F &&
+      config.min_p <= 0.F && !config.penalties_enabled() &&
+      !sampler.NeedsConstraintMask() && !sampler.SaveDrawState().pending;
+  return plain ? config.temperature : 0.F;
+}
+
