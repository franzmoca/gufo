+int Session::SampleNext(sampling::SamplerState& sampler,
+                        std::string* error_msg) const {
+  if (const float temperature = DeviceSamplingTemperature(sampler);
+      temperature > 0.F) {
+    const auto state = sampler.rng_state();
+    const int token =
+        ds41_session_sample_device(session_, temperature, sampler.Uniform());
+    if (token >= 0)
+      return token;
+    sampler.SetRngState(state);
+  }
+  const auto logits = CopyLogits(error_msg);
+  return logits.empty() ? -1 : static_cast<int>(sampler.Sample(logits));
+}
